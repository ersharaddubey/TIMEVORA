<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/fw_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_card_bg" android:contentDescription="@null" />
    <LinearLayout
        android:id="@+id/fw_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/fw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🍅 Start a focus session" android:textColor="#282C3F" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/fw_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today 0m" android:textColor="#6B7088" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:id="@+id/fw_p15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="0dp">
            <ImageView android:id="@+id/fw_p15_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/fw_p15_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="15m" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/fw_p25" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="5dp">
            <ImageView android:id="@+id/fw_p25_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/fw_p25_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="25m" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/fw_p45" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="5dp">
            <ImageView android:id="@+id/fw_p45_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/fw_p45_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="45m" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/fw_p60" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="5dp">
            <ImageView android:id="@+id/fw_p60_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/fw_p60_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="60m" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/fw_pomo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="5dp">
            <ImageView android:id="@+id/fw_pomo_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/fw_pomo_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🍅" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/fw_run"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone">
        <TextView android:id="@+id/fw_run_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FOCUS SESSION" android:textColor="#6B7088" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        <Chronometer android:id="@+id/fw_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#282C3F" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:id="@+id/fw_run_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to open timevora" android:textColor="#6B7088" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
