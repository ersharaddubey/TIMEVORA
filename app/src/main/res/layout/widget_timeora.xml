<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_card_bg" android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="timevora" android:textColor="#FF3F6C" android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="↻ Refresh" android:textColor="#6B7088" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="TODAY" android:textColor="#6B7088" android:textSize="10sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_lbl_screen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCREEN TIME" android:textColor="#6B7088" android:textSize="9sp" />
                <TextView android:id="@+id/widget_screen_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0m" android:textColor="#282C3F" android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="3dp" />
                <TextView android:id="@+id/widget_lbl_focus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOCUS" android:textColor="#6B7088" android:textSize="9sp" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/widget_focus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0m" android:textColor="#282C3F" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_lbl_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EARNED TODAY" android:textColor="#6B7088" android:textSize="9sp" />
                <TextView android:id="@+id/widget_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0 XP" android:textColor="#FF3F6C" android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="3dp" />
                <TextView android:id="@+id/widget_lbl_habits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HABITS" android:textColor="#6B7088" android:textSize="9sp" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/widget_habits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0 done" android:textColor="#282C3F" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/widget_lbl_life" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LIFE SCORE" android:textColor="#6B7088" android:textSize="9sp" />
            <TextView android:id="@+id/widget_life_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FF3F6C" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <FrameLayout android:id="@+id/widget_add_task" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginStart="0dp">
            <ImageView android:id="@+id/widget_add_task_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_add_task_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="＋ Task" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/widget_add_note" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginStart="6dp">
            <ImageView android:id="@+id/widget_add_note_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_add_note_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📝 Note" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
            <FrameLayout android:id="@+id/widget_add_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginStart="6dp">
            <ImageView android:id="@+id/widget_add_voice_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill_bg" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_add_voice_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🎤 Voice" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
